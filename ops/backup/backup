#!/bin/sh
set -eu

: "${DATABASE_URL:?DATABASE_URL is required}"
: "${HYDRA_BACKUP_KEY_FILE:?HYDRA_BACKUP_KEY_FILE is required}"

backup_dir="${HYDRA_BACKUP_DIR:-/backups}"
retention_days="${HYDRA_BACKUP_RETENTION_DAYS:-30}"
database_url="$DATABASE_URL"
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$database_url" in
  ecto://*) database_url="postgresql://${database_url#ecto://}" ;;
esac

case "$retention_days" in
  ''|*[!0-9]*) echo "HYDRA_BACKUP_RETENTION_DAYS must be a non-negative integer" >&2; exit 64 ;;
esac

if [ ! -r "$HYDRA_BACKUP_KEY_FILE" ]; then
  echo "backup key file is not readable" >&2
  exit 66
fi

mkdir -p "$backup_dir"
umask 077
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
plain_dump="$(mktemp "${TMPDIR:-/tmp}/hydra-agent-dump.XXXXXX")"
encrypted_partial="$(mktemp "$backup_dir/.hydra-agent-$timestamp.partial.XXXXXX")"
nonce="${encrypted_partial##*.}"
final="$backup_dir/hydra-agent-$timestamp-$nonce.dump.enc"

cleanup() {
  rm -f "$plain_dump" "$encrypted_partial"
}
trap cleanup EXIT HUP INT TERM

# Do not stream pg_dump into the encryptor. A POSIX pipeline reports only the
# final command's status, so a failed dump could otherwise become a non-empty
# encrypted file. Validate the complete custom archive before encryption.
pg_dump --format=custom --no-owner --no-privileges --file="$plain_dump" "$database_url"
test -s "$plain_dump"
pg_restore --list "$plain_dump" >/dev/null

openssl enc -aes-256-cbc -salt -pbkdf2 -iter 600000 -md sha256 \
  -pass "file:$HYDRA_BACKUP_KEY_FILE" -in "$plain_dump" -out "$encrypted_partial"
test -s "$encrypted_partial"

# Verify the encryption round trip before publishing the archive name.
"$script_dir/check-backup" "$encrypted_partial" >/dev/null
mv "$encrypted_partial" "$final"
rm -f "$plain_dump"
trap - EXIT HUP INT TERM

find "$backup_dir" -type f -name 'hydra-agent-*.dump.enc' -mtime "+$retention_days" -delete
echo "$final"
