#!/bin/sh
set -eu

: "${HYDRA_BACKUP_KEY_FILE:?HYDRA_BACKUP_KEY_FILE is required}"
: "${RESTORE_TEST_DATABASE_URL:?RESTORE_TEST_DATABASE_URL is required}"

backup="${1:-}"
if [ -z "$backup" ] || [ ! -r "$backup" ]; then
  echo "usage: verify-backup /path/to/hydra-agent-*.dump.enc" >&2
  exit 64
fi

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"$script_dir/check-backup" "$backup" >/dev/null

restore_database_url="$RESTORE_TEST_DATABASE_URL"
case "$restore_database_url" in
  ecto://*) restore_database_url="postgresql://${restore_database_url#ecto://}" ;;
esac

database_name="${restore_database_url%%\?*}"
database_name="${database_name##*/}"
case "$database_name" in
  *restore_test*|*backup_verify*) ;;
  *)
    echo "refusing to replace a database whose name lacks restore_test or backup_verify" >&2
    exit 64
    ;;
esac

temporary="$(mktemp "${TMPDIR:-/tmp}/hydra-backup-verify.XXXXXX")"
trap 'rm -f "$temporary"' EXIT HUP INT TERM

openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -md sha256 \
  -pass "file:$HYDRA_BACKUP_KEY_FILE" -in "$backup" -out "$temporary"

psql "$restore_database_url" -v ON_ERROR_STOP=1 \
  -c 'DROP SCHEMA IF EXISTS public CASCADE' \
  -c 'CREATE SCHEMA public'
pg_restore --exit-on-error --no-owner --no-privileges \
  --dbname "$restore_database_url" "$temporary"

migration_count="$(psql "$restore_database_url" -v ON_ERROR_STOP=1 -Atqc \
  'SELECT count(*) FROM schema_migrations')"
case "$migration_count" in
  ''|0|*[!0-9]*)
    echo "restored database has no migration ledger" >&2
    exit 1
    ;;
esac

core_table_count="$(psql "$restore_database_url" -v ON_ERROR_STOP=1 -Atqc \
  "SELECT count(*) FROM unnest(ARRAY[
    'public.workspaces',
    'public.users',
    'public.runs',
    'public.simulations',
    'public.simulation_run_records',
    'public.run_snapshots',
    'public.oban_jobs'
  ]) AS required(name)
  WHERE to_regclass(required.name) IS NOT NULL")"

if [ "$core_table_count" != "7" ]; then
  echo "restored database is missing one or more core application tables" >&2
  exit 1
fi

record_counts="$(psql "$restore_database_url" -v ON_ERROR_STOP=1 -Atqc \
  "SELECT concat(
    'workspaces=', (SELECT count(*) FROM workspaces),
    ' users=', (SELECT count(*) FROM users),
    ' runs=', (SELECT count(*) FROM runs),
    ' simulations=', (SELECT count(*) FROM simulations),
    ' run_snapshots=', (SELECT count(*) FROM run_snapshots)
  )")"

echo "restore verified: $migration_count migrations; $core_table_count core tables; $record_counts"
