<div class="simulation-studio simulation-workbench simulation-stage-shell">
  <header class="simulation-workbench-header">
    <div class="simulation-workbench-topline">
      <a href={index_path(@workspace.id, @locale)} class="simulation-back-link">
        <span aria-hidden="true">←</span> {t(@locale, :back)}
      </a>
      <nav class="blueprint-locale-switch" aria-label={t(@locale, :locale_label)}>
        <a
          href={stage_path(@simulation.id, Atom.to_string(@stage), @workspace.id, "en")}
          aria-current={if @locale == "en", do: "page"}
        >
          {t(@locale, :english)}
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={stage_path(@simulation.id, Atom.to_string(@stage), @workspace.id, "ru")}
          aria-current={if @locale == "ru", do: "page"}
        >
          {t(@locale, :russian)}
        </a>
      </nav>
    </div>
    <div class="simulation-workbench-title">
      <div>
        <p class="blueprint-eyebrow">
          {t(
            @locale,
            workbench_status_key(@stage, @simulation, @latest_run, @run_readiness)
          )} · v{@simulation.active_version.version}
        </p>
        <h1>{@simulation.title}</h1>
        <p>{@simulation.question}</p>
      </div>
    </div>
  </header>

  <nav class="simulation-lifecycle" aria-label={t(@locale, :current_stage)}>
    <a
      href={stage_path(@simulation.id, "build", @workspace.id, @locale)}
      aria-current={if @stage == :build, do: "step"}
    >
      <span>01</span><strong>{t(@locale, :build)}</strong>
    </a>
    <a
      href={stage_path(@simulation.id, "run", @workspace.id, @locale)}
      aria-current={if @stage == :run, do: "step"}
    >
      <span>02</span><strong>{t(@locale, :run)}</strong>
    </a>
    <a
      href={stage_path(@simulation.id, "results", @workspace.id, @locale)}
      aria-current={if @stage in [:results, :compare], do: "step"}
    >
      <span>03</span><strong>{t(@locale, :explore)}</strong>
    </a>
  </nav>

  <%= case @stage do %>
    <% :run -> %>
      <section class="simulation-checkpoint-header">
        <div>
          <p class="blueprint-eyebrow">02 · {t(@locale, :run)}</p>
          <h2>{t(@locale, run_heading_key(@latest_run, @run_readiness))}</h2>
          <p>{t(@locale, run_lede_key(@latest_run, @run_readiness))}</p>
        </div>
        <span
          class={[
            "simulation-locked-seal",
            run_active?(@latest_run) && "is-progress"
          ]}
          aria-label={run_seal_label(@locale, @latest_run, @run_readiness)}
        >
          {run_seal_text(@latest_run)}
        </span>
      </section>

      <section
        :if={@latest_run}
        class="simulation-run-record"
        aria-label={t(@locale, :run_latest_record)}
        aria-live="polite"
        aria-busy={to_string(run_active?(@latest_run))}
        data-run-auto-refresh={if run_active?(@latest_run), do: "true"}
      >
        <header>
          <div>
            <p class="blueprint-eyebrow">{t(@locale, :run_latest_record)}</p>
            <strong>{t(@locale, run_status_key(@latest_run.run.status))}</strong>
          </div>
          <span>
            {t(@locale, mode_label(@latest_run.mode))} · {t(
              @locale,
              run_lineage_key(@latest_run.replay_kind)
            )}
          </span>
        </header>
        <div class="simulation-run-progress">
          <div>
            <span>{t(@locale, :run_progress)}</span>
            <strong>{run_progress(@latest_run)}</strong>
          </div>
          <progress
            aria-label={t(@locale, :run_progress)}
            value={@latest_run.current_round}
            max={@latest_run.rounds_planned}
          >
            {run_progress(@latest_run)}
          </progress>
        </div>
        <details class="simulation-run-details">
          <summary>{t(@locale, :run_details)}</summary>
          <dl>
            <div>
              <dt>{t(@locale, :run_seed)}</dt>
              <dd>{@latest_run.seed}</dd>
            </div>
            <div>
              <dt>{t(@locale, :run_pack_hash)}</dt>
              <dd>{short_hash(@latest_run.pack_hash)}</dd>
            </div>
            <div>
              <dt>{t(@locale, :run_engine)}</dt>
              <dd>{@latest_run.engine_version}</dd>
            </div>
            <div>
              <dt>{t(@locale, :run_model_calls)}</dt>
              <dd>{@latest_run.model_call_count}</dd>
            </div>
            <div>
              <dt>{t(@locale, :run_recoveries)}</dt>
              <dd>{@latest_run.recovery_count}</dd>
            </div>
            <div>
              <dt>{t(@locale, :run_result_hash)}</dt>
              <dd>
                {if @latest_run.result_hash,
                  do: short_hash(@latest_run.result_hash),
                  else: t(@locale, :run_no_result)}
              </dd>
            </div>
          </dl>
        </details>

        <section
          :if={
            @latest_run.mode == "balanced" && @cognition_summary &&
              @cognition_summary["decisions"] > 0
          }
          class="simulation-cognition"
          aria-labelledby="cognition-title"
        >
          <header>
            <div>
              <h3 id="cognition-title">{t(@locale, :cognition_title)}</h3>
              <p>{t(@locale, :cognition_lede)}</p>
            </div>
          </header>
          <dl>
            <div>
              <dt>{t(@locale, :cognition_model)}</dt>
              <dd>{@cognition_summary["model_decisions"]}</dd>
            </div>
            <div>
              <dt>{t(@locale, :cognition_reused)}</dt>
              <dd>{@cognition_summary["reused_decisions"]}</dd>
            </div>
            <div>
              <dt>{t(@locale, :cognition_affected)}</dt>
              <dd>{@cognition_summary["affected_agents"]}</dd>
            </div>
            <div>
              <dt>{t(@locale, :cognition_fallbacks)}</dt>
              <dd>{@cognition_summary["fallback_decisions"]}</dd>
            </div>
          </dl>
          <details :if={@recent_decisions != []}>
            <summary>{t(@locale, :cognition_recent)}</summary>
            <ol>
              <li :for={decision <- @recent_decisions}>
                <span>
                  {tx(@locale, :cognition_round, round: decision.round)} · {t(
                    @locale,
                    cognition_source_key(decision.source)
                  )}
                </span>
                <strong>{context_identifier(decision.action_id, @locale)}</strong>
                <small>
                  {context_identifier(decision.agent_type, @locale)} · {cognition_agents_label(
                    decision.affected_agent_count,
                    @locale
                  )}
                </small>
              </li>
            </ol>
          </details>
        </section>

        <div
          :if={@can_edit && @latest_run.run.status == "completed"}
          class="simulation-replay-actions"
        >
          <form
            action={"/simulations/#{@simulation.id}/run/#{@latest_run.id}/replay?workspace_id=#{@workspace.id}&locale=#{@locale}"}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit">{t(@locale, :run_exact_replay)}</button>
            <small>{t(@locale, :run_exact_replay_hint)}</small>
          </form>
          <form
            action={"/simulations/#{@simulation.id}/run/#{@latest_run.id}/rerun?workspace_id=#{@workspace.id}&locale=#{@locale}"}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit">{t(@locale, :run_fresh_rerun)}</button>
            <small>{t(@locale, :run_fresh_rerun_hint)}</small>
          </form>
        </div>
      </section>

      <section
        :if={@budget_plan}
        class="simulation-budget-card"
        aria-labelledby="run-budget-title"
      >
        <header>
          <div>
            <p class="blueprint-eyebrow">{t(@locale, :budget_label)}</p>
            <h3 id="run-budget-title">{t(@locale, :budget_title)}</h3>
            <p>{t(@locale, :budget_lede)}</p>
          </div>
          <span>{t(@locale, budget_preset_key(@budget_plan))}</span>
        </header>

        <p class="simulation-budget-estimate">
          <span>{t(@locale, :budget_estimated_range)}</span>
          <strong>{budget_estimate_label(@locale, @budget_plan)}</strong>
        </p>

        <dl class="simulation-budget-strip">
          <div>
            <dt>{t(@locale, :budget_hard_max)}</dt>
            <dd>{budget_cost_label(@locale, @budget_plan)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :budget_model_calls)}</dt>
            <dd>{@budget_plan.hard_model_call_cap}</dd>
          </div>
          <div>
            <dt>{t(@locale, :budget_retrievals)}</dt>
            <dd>{@budget_plan.hard_retrieval_request_cap}</dd>
          </div>
          <div>
            <dt>{t(@locale, :budget_runtime)}</dt>
            <dd>{budget_runtime_band_label(@locale, @budget_plan)}</dd>
          </div>
        </dl>

        <dl :if={@latest_run} class="simulation-budget-strip is-live" aria-live="polite">
          <div>
            <dt>{t(@locale, :budget_used_remaining)}</dt>
            <dd>{budget_cost_progress_label(@locale, @budget_plan, @budget_summary)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :budget_decisions_remaining)}</dt>
            <dd>{budget_decision_progress_label(@locale, @budget_plan, @budget_summary)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :budget_fallbacks)}</dt>
            <dd>{@budget_summary["fallbacks"]}</dd>
          </div>
          <div>
            <dt>{t(@locale, :budget_current_stage)}</dt>
            <dd>{budget_stage_label(@locale, @latest_run)}</dd>
          </div>
        </dl>

        <p :if={@budget_plan.pricing_status != "known"} class="simulation-budget-note">
          {t(@locale, :budget_price_unknown_note)}
        </p>
        <p class="simulation-budget-note is-safe">
          <span aria-hidden="true">✓</span> {t(@locale, :budget_fallback_note)}
        </p>

        <details class="simulation-route-details">
          <summary>
            <span>
              <strong>{t(@locale, :models_title)}</strong>
              <small>{t(@locale, :models_summary)}</small>
            </span>
          </summary>

          <form
            :if={@can_edit && !run_active?(@latest_run)}
            action={"/simulations/#{@simulation.id}/run/configuration?workspace_id=#{@workspace.id}&locale=#{@locale}"}
            method="post"
            class="simulation-route-form"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <label>
              <span>{t(@locale, :model_build)}</span>
              <select name="run_configuration[model_routes][build]">
                <option
                  value="automatic"
                  selected={model_route_selection(@model_route_plan, "build") == "automatic"}
                >
                  {t(@locale, :model_automatic)}
                </option>
                <option
                  :for={provider <- @available_model_routes}
                  value={provider["id"]}
                  selected={model_route_selection(@model_route_plan, "build") == provider["id"]}
                >
                  {provider_option_label(provider)}
                </option>
              </select>
            </label>
            <div
              :if={@simulation.active_version.execution_mode == "quick"}
              class="simulation-route-fixed"
            >
              <span>{t(@locale, :model_simulation)}</span>
              <strong>
                {model_route_label(@locale, @model_route_plan.resolved_routes["simulation"])}
              </strong>
              <input
                type="hidden"
                name="run_configuration[model_routes][simulation]"
                value="none"
              />
            </div>
            <label :if={@simulation.active_version.execution_mode == "balanced"}>
              <span>{t(@locale, :model_simulation)}</span>
              <select name="run_configuration[model_routes][simulation]">
                <option
                  value="automatic"
                  selected={model_route_selection(@model_route_plan, "simulation") == "automatic"}
                >
                  {t(@locale, :model_automatic)}
                </option>
                <option
                  :for={provider <- @available_model_routes}
                  value={provider["id"]}
                  selected={
                    model_route_selection(@model_route_plan, "simulation") == provider["id"]
                  }
                >
                  {provider_option_label(provider)}
                </option>
              </select>
            </label>
            <label>
              <span>{t(@locale, :model_report)}</span>
              <select name="run_configuration[model_routes][report]">
                <option
                  value="automatic"
                  selected={model_route_selection(@model_route_plan, "report") == "automatic"}
                >
                  {t(@locale, :model_automatic)}
                </option>
                <option
                  :for={provider <- @available_model_routes}
                  value={provider["id"]}
                  selected={model_route_selection(@model_route_plan, "report") == provider["id"]}
                >
                  {provider_option_label(provider)}
                </option>
              </select>
            </label>
            <button type="submit">{t(@locale, :run_configuration_save)}</button>
          </form>

          <dl :if={!@can_edit || run_active?(@latest_run)} class="simulation-route-readonly">
            <div>
              <dt>{t(@locale, :model_build)}</dt>
              <dd>{model_route_label(@locale, @model_route_plan.resolved_routes["build"])}</dd>
            </div>
            <div>
              <dt>{t(@locale, :model_simulation)}</dt>
              <dd>
                {model_route_label(@locale, @model_route_plan.resolved_routes["simulation"])}
              </dd>
            </div>
            <div>
              <dt>{t(@locale, :model_report)}</dt>
              <dd>{model_route_label(@locale, @model_route_plan.resolved_routes["report"])}</dd>
            </div>
          </dl>
        </details>
      </section>

      <section class="simulation-ready-summary" aria-label={t(@locale, :ready_summary)}>
        <header>
          <p class="blueprint-eyebrow">{t(@locale, :ready_summary)}</p>
          <span>{t(@locale, :not_sample)}</span>
        </header>
        <dl>
          <div>
            <dt>{t(@locale, :population)}</dt>
            <dd>{@ready_summary.population_size}</dd>
          </div>
          <div>
            <dt>{t(@locale, :agent_types)}</dt>
            <dd>{@ready_summary.agent_types || t(@locale, :not_built)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :rounds)}</dt>
            <dd>{@ready_summary.rounds || t(@locale, :not_built)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :actions)}</dt>
            <dd>{@ready_summary.actions || t(@locale, :not_built)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :resources)}</dt>
            <dd>
              {if is_nil(@ready_summary.resources),
                do: t(@locale, :not_built),
                else: @ready_summary.resources}
            </dd>
          </div>
          <div>
            <dt>{t(@locale, :events)}</dt>
            <dd>
              {if is_nil(@ready_summary.scheduled_events),
                do: t(@locale, :not_built),
                else: @ready_summary.scheduled_events}
            </dd>
          </div>
          <div>
            <dt>{t(@locale, :script_preview)}</dt>
            <dd>{t(@locale, script_preview_status_key(@script_preview))}</dd>
          </div>
          <div>
            <dt>{t(@locale, :mode)}</dt>
            <dd>{t(@locale, mode_label(@ready_summary.execution_mode))}</dd>
          </div>
          <div>
            <dt>{t(@locale, :max_cost)}</dt>
            <dd>{budget_cost_label(@locale, @budget_plan)}</dd>
          </div>
          <div>
            <dt>{t(@locale, :max_decisions)}</dt>
            <dd>
              {if is_nil(@ready_summary.maximum_model_decisions),
                do: t(@locale, :not_estimated),
                else: @ready_summary.maximum_model_decisions}
            </dd>
          </div>
        </dl>
        <footer>
          <a href={stage_path(@simulation.id, "build", @workspace.id, @locale)}>
            {t(@locale, :edit_build)}
          </a>
          <a href={stage_path(@simulation.id, "script", @workspace.id, @locale)}>
            {t(@locale, :script_inspect)}
          </a>
          <form
            :if={@can_edit && run_active?(@latest_run)}
            action={"/simulations/#{@simulation.id}/run/#{@latest_run.id}/cancel?workspace_id=#{@workspace.id}&locale=#{@locale}"}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="simulation-run-cancel" type="submit">{t(@locale, :run_cancel)}</button>
          </form>
          <form
            :if={
              @can_edit && !run_active?(@latest_run) &&
                (!@latest_run || @latest_run.run.status != "completed") &&
                match?({:ok, _}, @run_readiness)
            }
            action={"/simulations/#{@simulation.id}/run?workspace_id=#{@workspace.id}&locale=#{@locale}"}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="simulation-run-start" type="submit">
              {t(@locale, :run_simulation)}
            </button>
          </form>
          <button
            :if={!@can_edit || (!run_active?(@latest_run) && !match?({:ok, _}, @run_readiness))}
            type="button"
            disabled
          >
            {t(@locale, :run_simulation)}
          </button>
        </footer>
      </section>
    <% :results -> %>
      <section class="simulation-stage-empty">
        <span aria-hidden="true">○</span>
        <p class="blueprint-eyebrow">04 · {t(@locale, :explore)}</p>
        <h2>{t(@locale, :results_title)}</h2>
        <strong>{t(@locale, :results_empty)}</strong>
        <p>{t(@locale, :results_empty_lede)}</p>
        <div>
          <span>{t(@locale, :locked)} · State</span>
          <span>{t(@locale, :locked)} · Flow</span>
          <span>{t(@locale, :locked)} · Explain</span>
        </div>
        <a href={stage_path(@simulation.id, "build", @workspace.id, @locale)}>
          {t(@locale, :edit_build)}
        </a>
        <a href={stage_path(@simulation.id, "compare", @workspace.id, @locale)}>
          {t(@locale, :compare_runs)}
        </a>
      </section>
    <% :compare -> %>
      <section class="simulation-stage-empty">
        <span aria-hidden="true">⇄</span>
        <p class="blueprint-eyebrow">{t(@locale, :compare)}</p>
        <h2>{t(@locale, :compare_title)}</h2>
        <strong>{t(@locale, :compare_empty)}</strong>
        <p>{t(@locale, :compare_empty_lede)}</p>
        <a href={stage_path(@simulation.id, "results", @workspace.id, @locale)}>
          {t(@locale, :explore)}
        </a>
      </section>
  <% end %>
</div>
