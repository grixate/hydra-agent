<main class="observatory-page" id="observatory" data-snapshots={Jason.encode!(@run.snapshots)}>
  <header class="obs-topbar">
    <a class="simlab-brand inverse" href="/demo/simulations">
      <span class="brand-mark">H</span><span>Hydra <em>Simulations</em></span>
    </a>
    <div class="obs-study">
      <span>DEMO</span>
      <h1>{@study.title}</h1>
      <i>·</i><span class="obs-variant-label">Illustrative run</span>
    </div>
    <div class="obs-status">
      <span>5k modeled population</span><span class="status-divider"></span><span>Large</span><span class="status-divider"></span><span id="cost-used">$0.00</span><span class="confidence-badge"><i></i> 62% confidence</span>
    </div>
  </header>

  <section class="observatory-layout">
    <aside class="timeline-panel">
      <div class="panel-label">
        <span>Scenario</span>
      </div>
      <div class="scenario-title">Certificates become visible</div>
      <p class="scenario-subtitle">Public-by-default profile block</p>
      <div class="event-list" id="event-list">
        <%= for {event, index} <- Enum.with_index(@study.events, 1) do %>
          <button
            class={"event-item #{if index == 2, do: "selected", else: ""}"}
            data-tick={index}
            aria-pressed={if index == 2, do: "true", else: "false"}
          >
            <span class="event-day">DAY {event.day}</span><strong><%= event.title %></strong><small><%= event.impact %></small>
          </button>
        <% end %>
      </div>
      <div class="timeline-foot"><span>60-day horizon</span><span>4 events</span></div>
    </aside>

    <section class="field-panel">
      <div class="field-toolbar">
        <div class="mode-switcher" role="tablist" aria-label="Observatory view">
          <button class="active" data-mode="constellation" role="tab" aria-selected="true">
            Constellation
          </button>
          <button data-mode="basins" role="tab" aria-selected="false" tabindex="-1">
            Action basins
          </button>
          <button
            data-mode="pattern"
            role="tab"
            aria-selected="false"
            tabindex="-1"
          >
            Pattern flow
          </button>
          <button
            data-mode="evidence"
            role="tab"
            aria-selected="false"
            tabindex="-1"
          >
            Evidence
          </button>
          <button
            data-mode="uncertainty"
            role="tab"
            aria-selected="false"
            tabindex="-1"
          >
            Uncertainty
          </button>
        </div>
        <div class="field-actions">
          <button id="zoom-out" aria-label="Zoom out">−</button><span
            id="zoom-lens"
            aria-live="polite"
          >COHORTS</span><button id="zoom-in" aria-label="Zoom in">+</button><button
            id="pause-play"
            aria-label="Pause replay"
          >Ⅱ</button><button
            id="reset-view"
            aria-label="Reset view"
          >⌖</button>
        </div>
      </div>
      <canvas id="simulation-particles" aria-hidden="true"></canvas><canvas
        id="simulation-field"
        width="1600"
        height="1000"
        tabindex="0"
        role="img"
        aria-describedby="simulation-text-summary"
        aria-label="Interactive simulation field showing behavioral cohorts moving toward actions"
      >
      </canvas>
      <div class="field-key">
        <span><i class="key-dot adopt"></i>Adopt</span><span><i class="key-dot resist"></i>Resist</span><span><i class="key-dot ignore"></i>Wait</span><span><i class="key-dot share"></i>Share</span>
      </div>
      <p class="field-mode-hint" id="field-mode-hint">Population weather · aggregate cohorts</p>
      <div class="field-notice" id="field-notice">
        <span class="notice-pulse"></span><span id="event-notice">Day 14 · Certificate block appears</span>
      </div>
      <div class="simulation-text-summary" id="simulation-text-summary">
        <strong>Text summary</strong>
        <%= for snapshot <- @run.snapshots do %>
          <span>
            {snapshot.label}: adopt {round(
              (snapshot.metrics[:adopt] || snapshot.metrics["adopt"] || 0) * 100
            )}%, resist {round(
              (snapshot.metrics[:resist] || snapshot.metrics["resist"] || 0) * 100
            )}%, wait {round((snapshot.metrics[:ignore] || snapshot.metrics["ignore"] || 0) * 100)}%, share {round(
              (snapshot.metrics[:share] || snapshot.metrics["share"] || 0) * 100
            )}%.
          </span>
        <% end %>
      </div>
    </section>

    <aside class="insight-panel" id="insight-panel">
      <div class="panel-label">
        <span>Signal found</span><span class="signal-score">High impact</span>
      </div>
      <div class="insight-intro">
        <p class="insight-kicker" id="selected-persona">PRIVACY-SENSITIVE EMPLOYEES</p>
        <h2 id="selected-title">Resistance is about control, not certificates.</h2>
        <p id="selected-summary">
          When the block becomes visible by default, this group reads it as HR surveillance—not a career signal.
        </p>
      </div>
      <div class="pattern-card">
        <div class="pattern-top"><span>ACTIVE PATTERN</span><b>38% contribution</b></div>
        <h3 id="pattern-name">Default visibility feels like surveillance</h3>
        <div class="grounding-row" id="grounding-row">
          <span class="source-pill web">5 web sources</span><span class="source-pill assumption">1 assumption</span>
        </div>
      </div>
      <div class="insight-section">
        <h3>What would reduce resistance?</h3>
        <a class="counterfactual" href="/login">
          <span class="counter-icon">↗</span><span><b>Make visibility opt-in</b><small>Illustrative estimate · resistance −12 pts</small></span><span>→</span>
        </a>
      </div>
      <button class="why-button" id="why-button">
        View evidence overlay <span>→</span>
      </button>
    </aside>
  </section>

  <footer class="replay-panel">
    <div class="replay-info">
      <span class="replay-label">REPLAY</span><strong id="replay-day">Day 14</strong><span id="replay-event">Certificate block appears</span>
    </div>
    <div class="scrubber-wrap">
      <input id="time-scrubber" type="range" min="1" max="4" value="2" aria-label="Replay day" />
      <div class="tick-labels">
        <span>Day 1</span><span>Day 14</span><span>Day 30</span><span>Day 60</span>
      </div>
    </div>
    <div class="metrics">
      <div><span>ADOPT</span><b id="metric-adopt">38%</b><i class="metric-up">+8</i></div>
      <div><span>RESIST</span><b id="metric-resist">23%</b><i class="metric-down">−4</i></div>
      <div><span>WAIT</span><b id="metric-ignore">31%</b><i>—</i></div>
      <div><span>SHARE</span><b id="metric-share">8%</b><i class="metric-up">+2</i></div>
    </div>
    <div class="decision-proof">
      <span>20,000 <em>deterministic decisions</em></span><span>0 <em>provider calls</em></span><span><%= length(hd(@run.snapshots).clusters) %> <em>aggregate cohorts</em></span>
    </div>
  </footer>
</main>
