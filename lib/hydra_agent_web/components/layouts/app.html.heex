<div class="runtime-app">
  <% simulations_path = HydraAgentWeb.UserAuth.default_path(@current_user) %>
  <% locale = assigns[:locale] || "en" %>
  <a class="runtime-skip-link" href="#runtime-content">
    {HydraAgentWeb.BlueprintCopy.t(locale, :skip)}
  </a>
  <header class="runtime-topbar">
    <a
      href="/"
      class="runtime-brand"
      aria-label={HydraAgentWeb.BlueprintCopy.t(locale, :brand_home)}
    >
      <span class="runtime-brand-mark" aria-hidden="true">H</span>
      <span>Hydra</span>
    </a>

    <nav
      class="runtime-global-nav"
      aria-label={HydraAgentWeb.BlueprintCopy.t(locale, :global_nav)}
    >
      <a href={simulations_path}>
        {HydraAgentWeb.BlueprintCopy.t(locale, :nav_simulations)}
      </a>
      <a href={"/blueprints?locale=#{locale}"}>
        {HydraAgentWeb.BlueprintCopy.t(locale, :nav_blueprints)}
      </a>
      <a
        href={if @current_user, do: ~p"/account/security", else: "/control/settings"}
        class="runtime-account-button runtime-account-link"
        aria-label={
          @current_user &&
            HydraAgentWeb.BlueprintCopy.account_settings_label(locale, @current_user.display_name)
        }
      >
        {HydraAgentWeb.BlueprintCopy.t(locale, :nav_settings)}
      </a>
      <a :if={HydraAgent.Accounts.operations_authorized?(@current_user)} href="/control">
        {HydraAgentWeb.BlueprintCopy.t(locale, :nav_operations)}
      </a>
      <form :if={@current_user} action={~p"/logout"} method="post">
        <input type="hidden" name="_method" value="delete" />
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button
          type="submit"
          class="runtime-account-button runtime-signout-button"
          aria-label={HydraAgentWeb.BlueprintCopy.t(locale, :nav_sign_out)}
        >
          {HydraAgentWeb.BlueprintCopy.t(locale, :nav_sign_out)}
        </button>
      </form>
    </nav>
  </header>

  <main id="runtime-content" class="runtime-content" tabindex="-1">
    <.flash_group flash={@flash} locale={locale} />
    {@inner_content}
  </main>
</div>
