<div class="runtime-app">
  <% simulations_path = HydraAgentWeb.UserAuth.default_path(@current_user) %>
  <a class="runtime-skip-link" href="#runtime-content">Skip to content</a>
  <header class="runtime-topbar">
    <a href="/" class="runtime-brand" aria-label="Hydra home">
      <span class="runtime-brand-mark" aria-hidden="true">H</span>
      <span>Hydra</span>
    </a>

    <nav class="runtime-global-nav" aria-label="Global navigation">
      <a href="/control">Workspace</a>
      <a href={simulations_path}>Studies</a>
      <a href="/control/runtime" class="runtime-system-link">
        <span class="runtime-status-dot" aria-hidden="true"></span> System
      </a>
      <a
        :if={@current_user}
        href={~p"/account/security"}
        class="runtime-account-button runtime-account-link"
        aria-label={"Account settings for #{@current_user.display_name}"}
      >
        Account
      </a>
      <form :if={@current_user} action={~p"/logout"} method="post">
        <input type="hidden" name="_method" value="delete" />
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button
          type="submit"
          class="runtime-account-button runtime-signout-button"
          aria-label="Sign out"
        >
          Sign out
        </button>
      </form>
    </nav>
  </header>

  <main id="runtime-content" class="runtime-content" tabindex="-1">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
